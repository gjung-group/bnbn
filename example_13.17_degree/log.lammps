      attributes: full, newton on, ghost
      pair build: full/bin/ghost
      stencil: full/ghost/bin/3d
      bin: standard
  (2) pair extep, perpetual, trim from (1)
      attributes: full, newton on, ghost, cut 4.2
      pair build: trim
      stencil: none
      bin: none
